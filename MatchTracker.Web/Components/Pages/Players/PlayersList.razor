@page "/maps"
@rendermode InteractiveServer
@inject MapsApi Api
@using MatchTracker

<div class="page-shell">
    <h3 class="page-title">Maps</h3>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="status-message">
            <b>@_message</b>
        </div>
    }

    <div class="crud-section">
        <h4>Create Map</h4>
        <div class="form-row">
            <input type="number" @bind="_createGameId" placeholder="Game ID" />
            <input @bind="_createName" placeholder="Map name" />
            <button @onclick="CreateMap">Create</button>
        </div>
    </div>

    <div class="crud-section">
        <h4>Get Map By ID</h4>
        <div class="form-row">
            <input type="number" @bind="_lookupId" />
            <button @onclick="LookupMap">Get One</button>
        </div>

        @if (_selected is not null)
        {
            <div>
                <p>MapId: @_selected.MapId</p>
                <p>GameId: @_selected.GameId</p>
                <p>Name: @_selected.Name</p>
            </div>
        }
    </div>

    <div class="crud-section">
        <h4>Get Maps By Game</h4>
        <div class="form-row">
            <input type="number" @bind="_subsetGameId" />
            <button @onclick="LoadByGame">Load Subset</button>
        </div>

        @if (_subsetItems is not null)
        {
            <ul class="results-list">
                @foreach (var m in _subsetItems)
                {
                    <li>@m.MapId - @m.Name</li>
                }
            </ul>
        }
    </div>

    <div class="crud-section">
        <h4>Update Map</h4>
        <div class="form-row">
            <input type="number" @bind="_updateId" placeholder="Map ID" />
            <input @bind="_updateName" placeholder="New name" />
            <button @onclick="UpdateMap">Update</button>
        </div>
    </div>

    <div class="crud-section">
        <h4>Delete Map</h4>
        <div class="form-row">
            <input type="number" @bind="_deleteId" placeholder="Map ID" />
            <button @onclick="DeleteMap">Delete</button>
        </div>
    </div>

    <div class="crud-section">
        <h4>All Maps</h4>
        <div class="form-row">
            <button @onclick="LoadAll">Refresh</button>
        </div>

        @if (_items is null)
        {
            <p>Loading...</p>
        }
        else if (_items.Count == 0)
        {
            <p>No maps found.</p>
        }
        else
        {
            <ul class="results-list">
                @foreach (var m in _items)
                {
                    <li>@m.MapId - Game @m.GameId - @m.Name</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private List<Map>? _items;
    private List<Map>? _subsetItems;
    private Map? _selected;
    private string _message = "";

    private int _createGameId = 1;
    private string _createName = "";
    private int _lookupId = 1;
    private int _subsetGameId = 1;
    private int _updateId = 1;
    private string _updateName = "";
    private int _deleteId = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        _items = await Api.GetAllAsync();
    }

    private async Task LookupMap()
    {
        _selected = await Api.GetByIdAsync(_lookupId);
        _message = _selected is null ? "Map not found." : "Map loaded.";
    }

    private async Task LoadByGame()
    {
        _subsetItems = await Api.GetByGameAsync(_subsetGameId);
        _message = $"Loaded {_subsetItems.Count} map(s) for game {_subsetGameId}.";
    }

    private async Task CreateMap()
    {
        if (string.IsNullOrWhiteSpace(_createName))
        {
            _message = "Enter a map name.";
            return;
        }

        var id = await Api.CreateAsync(_createGameId, _createName);
        _message = $"Map created with ID {id}.";
        _createName = "";
        await LoadAll();
    }

    private async Task UpdateMap()
    {
        if (string.IsNullOrWhiteSpace(_updateName))
        {
            _message = "Enter a new map name.";
            return;
        }

        var rows = await Api.UpdateAsync(_updateId, _updateName);
        _message = $"Update result: {rows}";
        await LoadAll();
    }

    private async Task DeleteMap()
    {
        var rows = await Api.DeleteAsync(_deleteId);
        _message = $"Delete result: {rows}";
        await LoadAll();
        if (_selected?.MapId == _deleteId) _selected = null;
    }
}