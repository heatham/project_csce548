@page "/maps"
@inject MapsApi Api
@using MatchTracker

<h3>Maps (All)</h3>

@if (_items is null)
{
    <p>Loading...</p>
}
else if (_items.Count == 0)
{
    <p>No maps found.</p>
}
else
{
    <ul>
        @foreach (var m in _items)
        {
            <li>
                <a href="@($"/maps/{m.MapId}")">
                    @m.MapId - @m.Name
                </a>
            </li>
        }
    </ul>
}

@code {
    private List<Map>? _items;

    protected override async Task OnInitializedAsync()
        => _items = await Api.GetAllAsync();
}