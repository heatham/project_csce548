@page "/maps/{Id:int}"
@inject MapsApi Api
@using MatchTracker

<h3>Map (Single)</h3>

@if (_item is null)
{
    <p>Not found.</p>
}
else
{
    <p><b>MapId:</b> @_item.MapId</p>
    <p><b>GameId:</b> @_item.GameId</p>
    <p><b>Name:</b> @_item.Name</p>
}

@code {
    [Parameter] public int Id { get; set; }

    private Map? _item;

    protected override async Task OnParametersSetAsync()
        => _item = await Api.GetByIdAsync(Id);
}