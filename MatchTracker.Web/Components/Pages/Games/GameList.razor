@page "/games"
@rendermode InteractiveServer
@inject GamesApi Api
@using MatchTracker

<div class="page-shell">
    <h3 class="page-title">Games</h3>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="status-message">
            <b>@_message</b>
        </div>
    }

    <div class="crud-section">
        <h4>Create Game</h4>
        <div class="form-row">
            <input @bind="_createName" placeholder="Game name" />
            <button @onclick="CreateGame">Create</button>
        </div>
    </div>

    <div class="crud-section">
        <h4>Get Game By ID</h4>
        <div class="form-row">
            <input type="number" @bind="_lookupId" />
            <button @onclick="LookupGame">Get One</button>
        </div>

        @if (_selected is not null)
        {
            <div>
                <p>GameId: @_selected.GameId</p>
                <p>Name: @_selected.Name</p>
            </div>
        }
    </div>

    <div class="crud-section">
        <h4>Update Game</h4>
        <div class="form-row">
            <input type="number" @bind="_updateId" placeholder="Game ID" />
            <input @bind="_updateName" placeholder="New name" />
            <button @onclick="UpdateGame">Update</button>
        </div>
    </div>

    <div class="crud-section">
        <h4>Delete Game</h4>
        <div class="form-row">
            <input type="number" @bind="_deleteId" placeholder="Game ID" />
            <button @onclick="DeleteGame">Delete</button>
        </div>
    </div>

    <div class="crud-section">
        <h4>All Games</h4>
        <div class="form-row">
            <button @onclick="LoadAll">Refresh</button>
        </div>

        @if (_items is null)
        {
            <p>Loading...</p>
        }
        else if (_items.Count == 0)
        {
            <p>No games found.</p>
        }
        else
        {
            <ul class="results-list">
                @foreach (var g in _items)
                {
                    <li>@g.GameId - @g.Name</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private List<Game>? _items;
    private Game? _selected;
    private string _message = "";

    private string _createName = "";
    private int _lookupId = 1;
    private int _updateId = 1;
    private string _updateName = "";
    private int _deleteId = 1;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        _items = await Api.GetAllAsync();
    }

    private async Task LookupGame()
    {
        _selected = await Api.GetByIdAsync(_lookupId);
        _message = _selected is null ? "Game not found." : "Game loaded.";
    }

    private async Task CreateGame()
    {
        if (string.IsNullOrWhiteSpace(_createName))
        {
            _message = "Enter a game name.";
            return;
        }

        var id = await Api.CreateAsync(_createName);
        _message = $"Game created with ID {id}.";
        _createName = "";
        await LoadAll();
    }

    private async Task UpdateGame()
    {
        if (string.IsNullOrWhiteSpace(_updateName))
        {
            _message = "Enter a new name.";
            return;
        }

        var rows = await Api.UpdateAsync(_updateId, _updateName);
        _message = $"Update result: {rows}";
        await LoadAll();
    }

    private async Task DeleteGame()
    {
        var rows = await Api.DeleteAsync(_deleteId);
        _message = $"Delete result: {rows}";
        await LoadAll();
        if (_selected?.GameId == _deleteId) _selected = null;
    }
}